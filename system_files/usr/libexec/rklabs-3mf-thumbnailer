#!/bin/bash
# Thumbnailer for 3MF files: rklabs-3mf-thumbnailer <size> <input> <output>
#
# Slicer project files (Bambu Studio, Orca, Prusa) keep their meshes in
# 3D/Objects/*.model, which f3d's assimp importer can't load. They do embed
# preview renders, so use one of those, and fall back to f3d for plain 3MFs.

size=$1 input=$2 output=$3

for entry in Metadata/thumbnail.png Metadata/plate_1.png Auxiliaries/.thumbnails/thumbnail_middle.png; do
    if unzip -p "$input" "$entry" > "$output" 2>/dev/null && [ -s "$output" ]; then
        exit 0
    fi
done
rm -f "$output"

exec f3d --config=thumbnail --load-plugins=assimp --verbose=quiet \
    --output="$output" --resolution="$size,$size" "$input"
